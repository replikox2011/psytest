# =============================================================================
# 🔥 Firebase Configuration
# Скопируйте значения из Firebase Console > Project settings > General > Your apps
# =============================================================================
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# =============================================================================
# 👤 Первоначальный аккаунт Администратора (используется на /setup)
# =============================================================================
REACT_APP_ADMIN_FULL_NAME=Администратор системы
REACT_APP_ADMIN_USERNAME=admin
REACT_APP_ADMIN_NICKNAME=admin
REACT_APP_ADMIN_EMAIL=admin@example.com
REACT_APP_ADMIN_PASSWORD=change_this_password_123!
REACT_APP_ADMIN_SALT=unique_salt_here
REACT_APP_ADMIN_UID=UID-ADMIN001
